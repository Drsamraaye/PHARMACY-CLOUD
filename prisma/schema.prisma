generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  branches         Branch[]
  users            UserProfile[]
  products         Product[]
  patients         Patient[]
  suppliers        Supplier[]
  sales            Sale[]
  purchases        Purchase[]
  subscriptions    Subscription[]
  stripeCustomerId String?
  bankAccounts     BankAccount[]
  bankTransactions BankTransaction[]
  exchangeRates    ExchangeRate[]
  salePayments     SalePayment[]
  dailyCloseouts   DailyCloseout[]
}

model Branch {
  id             String          @id @default(cuid())
  tenantId       String
  name           String
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users          UserProfile[]
  products       Product[]
  patients       Patient[]
  sales          Sale[]
  purchases      Purchase[]
  suppliers      Supplier[]
  bankAccounts   BankAccount[]
  salePayments   SalePayment[]
  dailyCloseouts DailyCloseout[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model UserProfile {
  id           String      @id @default(cuid())
  tenantId     String
  branchId     String?
  groupId      String?
  email        String
  fullName     String
  passwordHash String
  role         String      @default("USER")
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  group        AdminGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@unique([tenantId, email])
  @@index([tenantId, branchId])
}

model AdminGroup {
  id         String        @id @default(cuid())
  tenantId   String
  name       String
  users      UserProfile[]
  privileges Privilege[]

  @@unique([tenantId, name])
}

model Privilege {
  id      String     @id @default(cuid())
  groupId String
  key     String
  allowed Boolean    @default(false)
  group   AdminGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, key])
}

model Subscription {
  id                   String    @id @default(cuid())
  tenantId             String
  plan                 String    @default("TRIAL")
  status               String    @default("TRIALING")
  trialEnds            DateTime?
  stripeSubscriptionId String?   @unique
  createdAt            DateTime  @default(now())
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

model Product {
  id                 String           @id @default(cuid())
  tenantId           String
  branchId           String?
  name               String
  genericName        String?
  category           String?
  manufacturer       String?
  barcode            String?
  type               String           @default("PHARMACY")
  reorderPoint       Int              @default(0)
  salePrice          Decimal          @default(0) @db.Decimal(12, 2)
  salePrice2         Decimal          @default(0) @db.Decimal(12, 2)
  salePriceCurrency  String           @default("USD")
  salePrice2Currency String           @default("SLSH")
  costPrice          Decimal          @default(0) @db.Decimal(12, 2)
  isActive           Boolean          @default(true)
  archivedAt         DateTime?
  archivedBy         String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch             Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  batches            ProductBatch[]
  saleItems          SaleItem[]
  purchaseItems      PurchaseItem[]
  history            ProductHistory[]
  refundItems        RefundItem[]
  creditNoteItems    CreditNoteItem[]

  @@index([tenantId, type, isActive])
  @@index([tenantId, name])
}

model ProductBatch {
  id         String    @id @default(cuid())
  productId  String
  batchNo    String?
  quantity   Int       @default(0)
  expiryDate DateTime?
  costPrice  Decimal   @default(0) @db.Decimal(12, 2)
  supplierId String?
  createdAt  DateTime  @default(now())
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([productId, expiryDate])
  @@index([supplierId])
}

model ProductHistory {
  id        String   @id @default(cuid())
  tenantId  String
  productId String
  userId    String?
  action    String
  details   String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId, createdAt])
}

model Patient {
  id        String    @id @default(cuid())
  tenantId  String
  branchId  String?
  fullName  String
  phone     String?
  age       Int?
  gender    String?
  email     String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  sales     Sale[]

  @@index([tenantId, deletedAt])
  @@index([tenantId, fullName])
}

model Supplier {
  id           String         @id @default(cuid())
  tenantId     String
  branchId     String?
  name         String
  phone        String?
  email        String?
  address      String?
  city         String?
  country      String?
  paymentTerms String?
  notes        String?
  createdAt    DateTime       @default(now())
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  purchases    Purchase[]
  batches      ProductBatch[]

  @@index([tenantId, branchId, name])
}

model Sale {
  id            String        @id @default(cuid())
  tenantId      String
  branchId      String?
  patientId     String?
  userId        String?
  type          String        @default("PHARMACY")
  total         Decimal       @default(0) @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(12, 2)
  paymentMethod String?
  status        String        @default("PAID")
  exchangeRate  Decimal       @default(1) @db.Decimal(14, 6)
  totalUsd      Decimal       @default(0) @db.Decimal(14, 2)
  createdAt     DateTime      @default(now())
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  patient       Patient?      @relation(fields: [patientId], references: [id], onDelete: SetNull)
  items         SaleItem[]
  refunds       Refund[]
  creditNotes   CreditNote[]
  payments      SalePayment[]

  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, exchangeRate])
}

/// Tenant-wide official USD to Somaliland Shilling rate history; branches share it.
model ExchangeRate {
  id        String   @id @default(cuid())
  tenantId  String
  rate      Decimal  @db.Decimal(14, 6)
  updatedBy String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

/// A payment line preserves its amount and currency independently of other lines.
model SalePayment {
  id            String   @id @default(cuid())
  tenantId      String
  branchId      String?
  saleId        String
  userId        String?
  method        String
  currency      String
  amount        Decimal  @db.Decimal(14, 2)
  exchangeRate  Decimal  @db.Decimal(14, 6)
  usdEquivalent Decimal  @db.Decimal(14, 2)
  createdAt     DateTime @default(now())
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  sale          Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([tenantId, branchId, createdAt])
  @@index([saleId, createdAt])
  @@index([tenantId, method, currency, createdAt])
}

/// Immutable finalized cash count for one branch and business day.
model DailyCloseout {
  id                 String   @id @default(cuid())
  tenantId           String
  branchId           String?
  businessDate       DateTime @db.Date
  closedBy           String
  closedAt           DateTime @default(now())
  exchangeRate       Decimal  @db.Decimal(14, 6)
  expectedCashSLSh   Decimal  @db.Decimal(14, 2)
  expectedCashUSD    Decimal  @db.Decimal(14, 2)
  expectedZaadSLSh   Decimal  @db.Decimal(14, 2)
  expectedZaadUSD    Decimal  @db.Decimal(14, 2)
  actualCashSLSh     Decimal  @db.Decimal(14, 2)
  actualCashUSD      Decimal  @db.Decimal(14, 2)
  actualZaadSLSh     Decimal  @db.Decimal(14, 2)
  actualZaadUSD      Decimal  @db.Decimal(14, 2)
  differenceCashSLSh Decimal  @db.Decimal(14, 2)
  differenceCashUSD  Decimal  @db.Decimal(14, 2)
  differenceZaadSLSh Decimal  @db.Decimal(14, 2)
  differenceZaadUSD  Decimal  @db.Decimal(14, 2)
  notes              String?
  status             String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch             Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([tenantId, branchId, businessDate])
  @@index([tenantId, businessDate])
  @@index([branchId, businessDate])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  costPrice Decimal @default(0) @db.Decimal(12, 2)
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model Refund {
  id              String       @id @default(cuid())
  tenantId        String
  saleId          String
  amount          Decimal      @db.Decimal(12, 2)
  exchangeRate    Decimal      @default(1) @db.Decimal(14, 6)
  reflectedInSale Boolean      @default(true)
  reason          String
  createdAt       DateTime     @default(now())
  sale            Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  items           RefundItem[]

  @@index([tenantId, saleId, createdAt])
}

model RefundItem {
  id        String  @id @default(cuid())
  refundId  String
  productId String
  quantity  Int
  costPrice Decimal @default(0) @db.Decimal(12, 2)
  refund    Refund  @relation(fields: [refundId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model CreditNote {
  id              String           @id @default(cuid())
  tenantId        String
  saleId          String
  patientId       String?
  kind            String           @default("BALANCE")
  amount          Decimal          @db.Decimal(12, 2)
  remainingAmount Decimal          @db.Decimal(12, 2)
  status          String           @default("AVAILABLE")
  createdAt       DateTime         @default(now())
  sale            Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  items           CreditNoteItem[]

  @@index([tenantId, patientId, status])
  @@index([tenantId, saleId, kind, createdAt])
}

model CreditNoteItem {
  id           String     @id @default(cuid())
  creditNoteId String
  productId    String
  quantity     Int
  unitPrice    Decimal    @db.Decimal(12, 2)
  costPrice    Decimal    @default(0) @db.Decimal(12, 2)
  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id])

  @@index([creditNoteId])
}

model Purchase {
  id           String         @id @default(cuid())
  tenantId     String
  branchId     String?
  supplierId   String?
  total        Decimal        @default(0) @db.Decimal(12, 2)
  paidAmount   Decimal        @default(0) @db.Decimal(12, 2)
  discount     Decimal        @default(0) @db.Decimal(12, 2)
  invoiceNo    String?
  notes        String?
  status       String         @default("UNPAID")
  exchangeRate Decimal        @default(1) @db.Decimal(14, 6)
  totalSLSh    Decimal        @default(0) @db.Decimal(14, 2)
  createdAt    DateTime       @default(now())
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  supplier     Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items        PurchaseItem[]

  @@index([tenantId, createdAt])
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  productId  String
  quantity   Int
  costPrice  Decimal  @db.Decimal(12, 2)
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])
}

/// Tenant-scoped storage for configurable business records whose fields vary by workflow.
model ModuleRecord {
  id          String    @id @default(cuid())
  tenantId    String
  branchId    String?
  collection  String
  record      Json
  externalRef String?   @unique
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([tenantId, collection, branchId, createdAt])
}

model BankAccount {
  id        String            @id @default(cuid())
  tenantId  String
  branchId  String?
  name      String
  currency  String            @default("USD")
  balance   Decimal           @default(0) @db.Decimal(14, 2)
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  entries   BankTransaction[]

  @@unique([tenantId, branchId, name])
  @@index([tenantId, branchId])
}

model BankTransaction {
  id            String      @id @default(cuid())
  tenantId      String
  bankAccountId String
  type          String
  amount        Decimal     @db.Decimal(14, 2)
  description   String?
  reference     String?
  createdBy     String?
  createdAt     DateTime    @default(now())
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@index([tenantId, bankAccountId, createdAt])
}
